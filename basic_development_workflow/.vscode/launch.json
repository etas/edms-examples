{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Recall Player",
            "type": "cppdbg",
            "request": "attach",
            "preLaunchTask": "Resolve dol_player_rest_server path",
            "processId": "${command:pickProcess}",
            "program": "${workspaceFolder}/.vscode/.dol_player_rest_server",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],   
}